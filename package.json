{
  "name": "glowfinder",
  "version": "1.0.0",
  "private": true,
  "description": "Five strategies hunt for a brighter jellyfish protein, scored against real lab data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "record-exemplar": "node scripts/record-exemplar.ts"
  },
  "dependencies": {
    "hono": "4.13.16",
    "molstar": "5.13.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
